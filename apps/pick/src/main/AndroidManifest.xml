<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      폴더블 전용: 힌지 각도 센서가 있는 기기(폴드·플립 등)만 Play 스토어에서 설치 가능.
      일반 폰·태블릿에는 앱이 보이지 않음 (그래도 앱 안의 뽑기 버튼 대비책은 유지)
    -->
    <uses-feature
        android:name="android.hardware.sensor.hinge_angle"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoldNumber">

        <!-- AdMob 앱 ID (build.gradle.kts에서 빌드 종류별로 넣음) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!--
          configChanges: 커버 화면 ↔ 메인 화면 전환 때 액티비티가 다시 만들어지지 않고
          그대로 이어지게 해서, 접힘 상태 변화를 끊김 없이 받기 위함
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
